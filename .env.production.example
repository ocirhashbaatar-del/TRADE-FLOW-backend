# Render/Railway backend Environment Variables
NODE_ENV=production
PORT=4000

# Vercel production domain. No trailing slash.
FRONTEND_URL=https://YOUR_VERCEL_PROJECT.vercel.app

# Managed PostgreSQL pooled/runtime connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate two different random secrets, at least 32 characters each.
JWT_ACCESS_SECRET=REPLACE_WITH_NEW_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Rotated production OAuth credentials.
GOOGLE_CLIENT_ID=REPLACE_WITH_NEW_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_NEW_GOOGLE_CLIENT_SECRET
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Render/Railway public backend URL. No trailing slash.
BACKEND_PUBLIC_URL=https://YOUR_BACKEND_SERVICE.onrender.com
AUTH_CALLBACK_URL=https://YOUR_VERCEL_PROJECT.vercel.app/auth/callback

# Upstash/Railway TLS Redis URL, normally starts with rediss://.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Required only when Cloudinary asset upload/sync is enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ASSET_SOURCE_DIR=../Supply/public/images

# Use newly rotated Stripe credentials.
STRIPE_SECRET_KEY=REPLACE_WITH_NEW_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_NEW_STRIPE_WEBHOOK_SECRET

# Optional email provider configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FreshFlow <noreply@YOUR_DOMAIN.mn>
