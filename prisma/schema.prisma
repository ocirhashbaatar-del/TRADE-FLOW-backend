generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  VENDOR
  TRANSPORTER
  ACCOUNTANT
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER
  INVENTORY
  SHIPMENT
  SYSTEM
  MESSAGE
}

enum ProductChannel {
  BOTH
  B2B
  B2C
}

enum StockMovementType {
  RECEIPT
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DISPOSAL
  RETURN
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model User {
  id                  String                   @id @default(cuid())
  name                String
  email               String                   @unique
  passwordHash        String?
  emailVerified       DateTime?
  phone               String?
  avatar              String?
  platformAdmin       Boolean                  @default(false)
  role                Role                     @default(CUSTOMER)
  tenant              String                   @default("TradeFlow")
  tenantId            String?
  refreshTokens       RefreshToken[]
  oauthAccounts       OAuthAccount[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  products            Product[]                @relation("VendorProducts")
  notifications       Notification[]
  cartItems           CartItem[]
  savedProducts       SavedProduct[]
  sentMessages        Message[]                @relation("SentMessages")
  receivedMessages    Message[]                @relation("ReceivedMessages")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@unique([provider, userId])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  image     String?
  tenantId  String?
  parentId  String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String
  price        Decimal        @db.Decimal(12, 2)
  compareAt    Decimal?       @db.Decimal(12, 2)
  stock        Int            @default(0)
  image        String
  images       String[]
  tags         String[]
  rating       Float          @default(0)
  reviewCount  Int            @default(0)
  featured     Boolean        @default(false)
  active       Boolean        @default(true)
  tenantId     String?
  sku          String?
  barcode      String?
  brand        String?
  unit         String         @default("ш")
  packSize     Int            @default(1)
  channel      ProductChannel @default(BOTH)
  trackBatch   Boolean        @default(false)
  vatRate      Decimal        @default(10) @db.Decimal(5, 2)
  costPrice    Decimal        @default(0) @db.Decimal(12, 2)
  reorderPoint Int            @default(0)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  vendorId     String
  vendor       User           @relation("VendorProducts", fields: [vendorId], references: [id])
  orderItems   OrderItem[]
  cartItems    CartItem[]
  savedBy      SavedProduct[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId, sku])
  @@index([categoryId])
  @@index([vendorId])
  @@index([name])
  @@index([tenantId, active])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  tenantId        String?
  channel         String        @default("B2C")
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  subtotal        Decimal       @db.Decimal(12, 2)
  deliveryFee     Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  recipientName   String
  phone           String
  city            String
  district        String
  address         String
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  @@unique([orderId, productId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, read])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
}

model Asset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  publicId  String   @unique
  mimeType  String
  bytes     Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  domain       String?  @unique
  logo         String?
  primaryColor String   @default("#059669")
  subscription String   @default("MVP")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RolePermission {
  id        String   @id @default(cuid())
  tenantId  String
  role      Role
  module    String
  canRead   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, role, module])
}

model StaffInvitation {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String
  role      Role
  tokenHash String   @unique
  expiresAt DateTime
  acceptedAt DateTime?
  invitedBy String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

model ProductVariant {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  sku       String
  barcode   String?
  name      String
  options   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
}

model PriceRule {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  customerId  String?
  groupCode   String?
  minQuantity Int       @default(1)
  price       Decimal   @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  priority    Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, productId, active])
}

model Promotion {
  id          String   @id @default(cuid())
  tenantId    String
  code        String?
  name        String
  productId   String?
  categoryId  String?
  discountPct Decimal? @db.Decimal(5, 2)
  discountAmt Decimal? @db.Decimal(12, 2)
  minQuantity Int      @default(1)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active, startsAt, endsAt])
}

model PriceHistory {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  ruleId    String?
  oldPrice  Decimal? @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  source    String
  changedBy String
  createdAt DateTime @default(now())

  @@index([tenantId, productId, createdAt])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  address   String?
  type      String   @default("WAREHOUSE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InventoryBalance {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  variantId   String?
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, warehouseId, productId, variantId])
  @@index([tenantId, productId])
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  variantId   String?
  batchId     String?
  type        StockMovementType
  quantity    Int
  unitCost    Decimal?          @db.Decimal(12, 2)
  reference   String?
  reason      String?
  reversesId  String?
  createdBy   String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, warehouseId, productId, createdAt])
}

model StockBatch {
  id          String    @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  variantId   String?
  batchNumber String
  expiresAt   DateTime?
  quantity    Int
  createdAt   DateTime  @default(now())

  @@unique([tenantId, warehouseId, productId, batchNumber])
  @@index([tenantId, expiresAt])
}

model StockReservation {
  id          String            @id @default(cuid())
  tenantId    String
  orderId     String
  warehouseId String
  productId   String
  variantId   String?
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId, productId, status])
  @@index([expiresAt, status])
}

model Shipment {
  id           String    @id @default(cuid())
  tenantId     String
  orderId      String
  warehouseId  String
  status       String    @default("PICKING")
  carrierName  String?
  trackingCode String?
  pickedBy     String?
  packedAt     DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, orderId])
}

model ShipmentLine {
  id          String   @id @default(cuid())
  tenantId    String
  shipmentId  String
  orderItemId String
  productId   String
  batchId     String?
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([tenantId, shipmentId])
}

model Supplier {
  id             String   @id @default(cuid())
  registrationNo String   @unique
  name           String
  phone          String?
  email          String?
  address        String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SupplierRelationship {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  paymentTerms String   @default("PREPAID")
  creditDays   Int      @default(0)
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, supplierId])
  @@index([tenantId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  tenantId    String
  code        String
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  productId       String
  variantId       String?
  orderedQty      Int
  receivedQty     Int      @default(0)
  unitCost        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@index([tenantId, purchaseOrderId])
}

model Invoice {
  id        String    @id @default(cuid())
  tenantId  String
  orderId   String
  code      String
  subtotal  Decimal   @db.Decimal(12, 2)
  vat       Decimal   @db.Decimal(12, 2)
  total     Decimal   @db.Decimal(12, 2)
  status    String    @default("OPEN")
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PaymentRecord {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  method     String
  reference  String
  paidAt     DateTime @default(now())
  recordedBy String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, reference])
  @@index([tenantId, customerId, paidAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  tenantId  String
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentId])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  verifiedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model QPayPayment {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  invoiceId   String   @unique
  paymentId   String?  @unique
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("PENDING")
  qrData      String
  callbackRaw Json?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, orderId])
}

model EbarimtReceipt {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String   @unique
  receiptNo String   @unique
  subtotal  Decimal  @db.Decimal(12, 2)
  vat       Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  status    String   @default("GENERATED")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model FinancialEntry {
  id        String   @id @default(cuid())
  tenantId  String
  account   String
  reference String
  debit     Decimal  @default(0) @db.Decimal(12, 2)
  credit    Decimal  @default(0) @db.Decimal(12, 2)
  period    String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([tenantId, period])
}

model PeriodLock {
  id       String   @id @default(cuid())
  tenantId String
  period   String
  lockedBy String
  lockedAt DateTime @default(now())

  @@unique([tenantId, period])
}

model CustomerAccount {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  registrationNo String?
  email          String?
  phone          String?
  groupCode      String?
  creditLimit    Decimal  @default(0) @db.Decimal(12, 2)
  creditUsed     Decimal  @default(0) @db.Decimal(12, 2)
  userId         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, registrationNo])
  @@unique([tenantId, userId])
  @@index([tenantId, groupCode])
}

model CustomerInvitation {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())

  @@index([tenantId, email])
}

model ReturnRequest {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String
  warehouseId String
  quantity    Int
  reason      String
  condition   String
  status      String   @default("REQUESTED")
  restock     Boolean  @default(false)
  approvedBy  String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, orderId])
}

model SupplierPayable {
  id              String    @id @default(cuid())
  tenantId        String
  supplierId      String
  purchaseOrderId String?
  amount          Decimal   @db.Decimal(12, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  dueDate         DateTime?
  status          String    @default("OPEN")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, supplierId, status])
}
